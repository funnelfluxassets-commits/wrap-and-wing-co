# Wrap & Wings Co - Firebase Real-Time Synchronization Config
# Get these values from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration (Web)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=wrap-and-wings-co.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wrap-and-wings-co
VITE_FIREBASE_STORAGE_BUCKET=wrap-and-wings-co.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
